{
  "opencollection": "1.0.0",
  "info": {
    "name": "Interfaze Chat API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Chat",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Create chat completion",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.interfaze.ai/v1/chat/completions",
            "headers": [
              {
                "name": "Authorization",
                "value": ""
              },
              {
                "name": "Content-Type",
                "value": ""
              },
              {
                "name": "x-show-additional-info",
                "value": ""
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Creates a model response for the given chat conversation."
        }
      ]
    }
  ],
  "bundled": true
}